# Build stage — Node 24 to match the npm 11 lockfile format (npm ci rejects
# lockfiles regenerated by npm 11 when installing with npm 10).
FROM node:24-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN NITRO_PRESET=node-server npm run build

# Runtime stage
FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/.output ./.output

# Nitro's node-server preset listens on PORT (default 3000), on all interfaces.
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
